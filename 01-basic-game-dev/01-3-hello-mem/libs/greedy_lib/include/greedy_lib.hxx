#pragma once

#include <cstddef>

// "Чужая" библиотека, которая выделяет память разными способами.
// C-линковка: одни и те же имена удобно и линковать напрямую, и искать
// через dlsym (нет C++ name mangling).
extern "C"
{

    /// new char[bytes] - глобальный operator new, какой есть в процессе.
    /// Если он запрещён, бросает std::bad_alloc (исключение спокойно
    /// пересекает границу .so - ABI одно и то же).
    char* greedy_new(std::size_t bytes);

    /// malloc(bytes). Если malloc в процессе запрещён интерпозицией из
    /// исполняемого файла, вызов попадёт в чужую реализацию и вернёт
    /// nullptr - библиотека об этом даже не узнает.
    void* greedy_malloc(std::size_t bytes);

    /// mmap напрямую, минуя C/C++ кучу. Запрет new/malloc его не
    /// задевает: запрет работает на уровне библиотечных функций, а не
    /// системных вызовов.
    void* greedy_mmap(std::size_t bytes);

    /// Собственный статический пул в .bss библиотеки: куча не нужна
    /// вообще, поэтому работает при любом запрете. bytes <= 1 MiB.
    char* greedy_pool(std::size_t bytes);

} // extern "C"
